# syntax=docker/dockerfile:1

FROM node:22-alpine AS development

WORKDIR /app

# Wymagane biblioteki systemowe (libc6-compat oraz openssl dla silnika Prisma w środowisku Alpine Linux)
RUN apk add --no-cache libc6-compat openssl

# Warstwowe kopiowanie zależności - wykorzystanie cache warstw Dockera przy npm ci
COPY package.json package-lock.json ./

# Instalacja wszystkich zależności (w tym devDependencies)
RUN npm ci

# Skopiowanie definicji schematu bazy danych i wygenerowanie klienta Prisma w obrazie
COPY --chown=node:node prisma ./prisma
RUN npx prisma generate

# Utworzenie katalogów i nadanie pełnych uprawnień dla wbudowanego użytkownika node (UID 1000)
RUN mkdir -p /app/node_modules /app/.next /app/prisma && \
    chown -R node:node /app

USER node

EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true

CMD ["sh", "-c", "npx prisma generate && npm run dev -- -H 0.0.0.0"]
