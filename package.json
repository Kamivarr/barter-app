{
  "name": "barter-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prisma": "docker compose exec app npx prisma",
    "docker:dev": "docker compose up",
    "docker:dev:build": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prisma:generate": "docker compose exec app npx prisma generate",
    "docker:prisma:migrate": "docker compose exec app npx prisma migrate dev",
    "docker:prisma:deploy": "docker compose exec app npx prisma migrate deploy",
    "docker:prisma:push": "docker compose exec app npx prisma db push",
    "docker:prisma:seed": "docker compose exec app npx prisma db seed"
  },
  "prisma": {
    "seed": "node --no-warnings --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
