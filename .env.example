DATABASE_URL="file:./dev.db"

# Port na którym aplikacja nasłuchuje w kontenerze i na hoście
PORT=3001

# Adres interfejsu sieciowego (0.0.0.0 pozwala na połączenia z zewnątrz kontenera)
HOSTNAME=0.0.0.0

# Tryb środowiskowy (development / production)
NODE_ENV=development

# Polling dla Next.js file-watchera w Dockerze (zapewnia bezproblemowy hot reload na wszystkich systemach)
WATCHPACK_POLLING=true

# Klucz do podpisywania sesyjnych tokenów JWT (min. 32 znaki dla HS256)
JWT_SECRET="barter_jwt_secret_development_key_min_32_bytes_super_secure_2026!"
